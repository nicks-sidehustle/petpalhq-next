# Dependencies
node_modules/

# Next.js
.next/
out/

# Vercel
.vercel

# Environment
.env
.env.local
.env.*.local

# Debug
npm-debug.log*
tsconfig.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local agent / orchestration state — do not commit
.omx/
.omc/
.claude/*
# Whitelist autonomous content cron files (need to be in repo so the scheduled
# agent can read them after a fresh clone):
!.claude/content-queue.json
!.claude/cron-content-runner.md
!.claude/content-cron-log.md
# Whitelist the content-pipeline skills + reusable workflows (version-controlled
# so the pipeline tooling survives a fresh clone / reaches other machines):
!.claude/skills/
!.claude/workflows/
.playwright-mcp/
.env*.local
.tmp-screenshots/

# Batch working dirs — ignore transient .batch-NN/ working dirs,
# but keep the .batch-archive/ provenance store tracked.
.batch-*/
!.batch-archive/
!.batch-archive/**

# Vale linter binary (~30MB), fetched on demand by scripts/gates/install-vale.sh
# at a pinned version + sha256. Tooling, not source — never commit it.
# (@vvago/vale was removed from devDependencies on 2026-08-12; its unretried,
# unchecksummed postinstall ran on every install incl. Vercel production and
# killed a Dead-ASIN guard run with ECONNRESET. See the script header.)
/.vale-bin/
